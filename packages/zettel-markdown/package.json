{
  "name": "@opral/zettel-markdown",
  "type": "module",
  "version": "1.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opral/zettel"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "format": "prettier ./src ./test --write"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opral/zettel-ast": "workspace:*",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@vitest/coverage-v8": "3.1.1",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "3.1.1"
  }
}
