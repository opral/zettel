{
  "name": "@opral/zettel-html",
  "type": "module",
  "version": "1.2.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opral/zettel"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "_filesComment": "Shipping src for better debugging experience",
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build",
    "test": "tsc --noEmit && vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier ./src --write"
  },
  "_comment": "Keep CSS imports as side effects while allowing JavaScript tree-shaking.",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opral/zettel-ast": "workspace:*",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@vitest/coverage-v8": "3.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "3.1.1"
  }
}
