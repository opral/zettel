{
  "name": "@opral/zettel-ast",
  "type": "module",
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opral/zettel"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "_filesComment": "Shipping src for better debugging experience",
  "files": [
    "dist",
    "src",
    "schema.json",
    "!dist/**/*.test.*",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build",
    "test": "tsc --noEmit && vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier ./src --write"
  },
  "_comment": "Required for tree-shaking https://webpack.js.org/guides/tree-shaking/#mark-the-file-as-side-effect-free",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "3.1.1"
  }
}
