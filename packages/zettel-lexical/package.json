{
  "name": "@opral/zettel-lexical",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opral/zettel"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier ./src --write"
  },
  "dependencies": {
    "@lexical/utils": "^0.30.0",
    "@opral/zettel-ast": "workspace:*",
    "@opral/zettel-html": "workspace:*"
  },
  "peerDependencies": {
    "lexical": "^0.30.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "lexical": "^0.30.0",
    "typescript": "~5.7.2",
    "vitest": "^3.1.1"
  }
}
